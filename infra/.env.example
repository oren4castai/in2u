# === Postgres ===
POSTGRES_USER=in2u
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=in2u

# === JWT ===
# Must be at least 32 characters; 64+ recommended. Generate with:
#   openssl rand -base64 64
JWT_SIGNING_KEY=REPLACE_WITH_64_PLUS_RANDOM_CHARS

# === Initial admin user (seeded on first startup if no admin exists) ===
ADMIN_SEED_EMAIL=admin@in2u.local
ADMIN_SEED_PASSWORD=ChangeMe123!

# === TLS / Domain (used by nginx.conf - replace <DOMAIN> there) ===
# Set your public hostname before issuing certs. Example: api.in2u.example
# PUBLIC_DOMAIN=api.in2u.example
